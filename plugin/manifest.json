{
    "manifestVersion": 5,
    "id": "com.zhuang.ai.panel",
    "name": "ZHUANG-AI插件",
    "version": "2.1.0",
    "main": "index.html",
    "host": {
        "app": "PS",
        "minVersion": "26.0.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "zhuangAiPanel",
            "label": {
                "default": "ZHUANG-AI插件"
            },
            "minimumSize": {
                "width": 360,
                "height": 560
            },
            "maximumSize": {
                "width": 1200,
                "height": 2000
            },
            "preferredDockedSize": {
                "width": 420,
                "height": 900
            },
            "preferredFloatingSize": {
                "width": 420,
                "height": 900
            }
        }
    ],
    "requiredPermissions": {
        "network": {
            "domains": "all"
        },
        "localFileSystem": "fullAccess"
    }
}
